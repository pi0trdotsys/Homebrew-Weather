<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_bg">#0a0f0a</color>
    <color name="widget_green">#33ff66</color>
    <color name="widget_green_dim">#4a6a4a</color>
    <color name="widget_amber">#ffb000</color>
    <color name="widget_cyan">#55ffff</color>
    <color name="widget_online">#33ff66</color>
    <color name="widget_offline">#ff5555</color>

    <!-- Per-widget-instance color theme palette (see WidgetTheme.kt). Each
         non-default theme reuses a primary hue already present in the app's
         palette above and pairs it with a purpose-built dim/"comment" shade
         for the header/footer role — these dim shades don't correspond to
         anything else in the app so they get their own entries here. -->
    <color name="widget_amber_dim">#806000</color>
    <color name="widget_cyan_dim">#2a6666</color>
    <!-- Per-day rain row: snow gets its own colour, distinct from rain (cyan)
         and storms (amber). -->
    <color name="widget_snow">#dfefff</color>
    <color name="widget_crimson">#ff5555</color>
    <color name="widget_crimson_dim">#703030</color>

    <!-- AQI category colors (US AQI 0..500+ breakpoints) — kept as their own
         named entries (not reused from widget_green/widget_amber above) so a
         future per-widget theme pass can retint AQI categories independently
         of the base terminal palette. -->
    <color name="widget_aqi_good">#33ff66</color>
    <color name="widget_aqi_moderate">#ffb000</color>
    <color name="widget_aqi_sensitive">#ff7a1a</color>
    <color name="widget_aqi_unhealthy">#ff3b3b</color>
    <color name="widget_aqi_very_unhealthy">#a64dff</color>
    <color name="widget_aqi_hazardous">#7f0000</color>

    <!-- Terminal 2.0 HUD accents (mockup → native; see docs/widget-spec.md).
         widget_hud_glow = cyan at ~45% alpha for the hero temp's text shadow;
         widget_hud_line = cyan at ~35% alpha for the hero separator. -->
    <color name="widget_hud_glow">#7355FFFF</color>
    <color name="widget_hud_line">#5955FFFF</color>
    <!-- widget_hud_grid = cyan at ~10% alpha (mirrors WIDGET_COLORS.hudGrid in
         src/lib/widget-tokens.ts) — used both for the background HUD grid
         texture (see widget_hud_grid_tile.png) and the 4-day grid's
         column-divider hairlines. -->
    <color name="widget_hud_grid">#1A55FFFF</color>
</resources>
