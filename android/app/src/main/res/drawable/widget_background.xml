<?xml version="1.0" encoding="utf-8"?>
<!-- Static layout-time default (actual runtime fill is swapped per-instance via
     WidgetTransparency, see widget_background_100/85/60/35.xml below — those
     mirror this file's shape + HUD grid layer, just with different fill alpha).
     radius bumped to 5dp (METRICS.radiusDp in src/lib/widget-tokens.ts) for the
     Terminal 2.0 4x2 redesign; the 2nd layer is a faint tiled 16dp cyan grid
     texture (widget_hud_grid_tile.png) — unmasked/un-radial-faded, an
     accepted simplification per docs/widget-spec.md §3.1. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <stroke android:width="1dp" android:color="@color/widget_green_dim" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/widget_hud_grid_tile"
            android:tileMode="repeat" />
    </item>
    <!-- HUD corner brackets (see widget_hud_corners.xml) - composed in rather
         than duplicated into each alpha variant. -->
    <item android:drawable="@drawable/widget_hud_corners" />
</layer-list>
