<?xml version="1.0" encoding="utf-8"?>
<!-- High (~85%) fill-alpha variant — see widget_background_100.xml's comment. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D90A0F0A" />
            <stroke android:width="1dp" android:color="@color/widget_green_dim" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/widget_hud_grid_tile"
            android:tileMode="repeat" />
    </item>
    <!-- HUD corner brackets (see widget_hud_corners.xml) - composed in rather
         than duplicated into each alpha variant. -->
    <item android:drawable="@drawable/widget_hud_corners" />
</layer-list>
