<?xml version="1.0" encoding="utf-8"?>
<!-- Four L-shaped HUD corner brackets, drawn as 8 gravity-placed bars.

     docs/widget-spec.md Sec.3 item 3 asked for these from the start and every
     previous pass skipped them ("nice-to-have", and 4 extra ImageViews is real
     RemoteViews budget). They cost nothing as a drawable: <item android:width/
     height/gravity> (API 23+, we're minSdk 24) places a bar at a corner without
     knowing the widget's size, so this is a single layer-list the background
     drawables compose in - zero extra views, no runtime work.

     They're the cheapest thing that makes the frame read as an instrument
     panel rather than a rounded rectangle with text in it, which is the whole
     "Terminal 2.0" idea the rest of the widget is already committed to. Inset
     3dp so they float just inside the 1dp border instead of fighting it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- top-left -->
    <item android:left="3dp" android:top="3dp" android:width="11dp" android:height="2dp" android:gravity="top|left">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:width="2dp" android:height="11dp" android:gravity="top|left">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>

    <!-- top-right -->
    <item android:right="3dp" android:top="3dp" android:width="11dp" android:height="2dp" android:gravity="top|right">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>
    <item android:right="3dp" android:top="3dp" android:width="2dp" android:height="11dp" android:gravity="top|right">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>

    <!-- bottom-left -->
    <item android:left="3dp" android:bottom="3dp" android:width="11dp" android:height="2dp" android:gravity="bottom|left">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>
    <item android:left="3dp" android:bottom="3dp" android:width="2dp" android:height="11dp" android:gravity="bottom|left">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>

    <!-- bottom-right -->
    <item android:right="3dp" android:bottom="3dp" android:width="11dp" android:height="2dp" android:gravity="bottom|right">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp" android:width="2dp" android:height="11dp" android:gravity="bottom|right">
        <shape android:shape="rectangle"><solid android:color="@color/widget_hud_line" /></shape>
    </item>
</layer-list>
