<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal 2.0 — single adaptive layout.

     THIS FILE DECLARES NO ROW HEIGHTS AND NO FINAL TEXT SIZES. Every textSize
     here is a layout-editor placeholder that WeatherWidgetProvider overwrites on
     every render via setTextViewTextSize(), and every icon sizes itself to the
     bitmap it is given (see WidgetGraphics.sized()). Structure lives here; sizes
     live in WidgetMetrics.kt. Do not "fix" a size by editing this file — change
     the reference ladder in WidgetMetrics instead, or it will only be right at
     one widget size again.

     ## What this replaced

     Two files: this one with hard-coded dp rows tuned for 250x165dp, plus
     weather_widget_compact.xml for anything shorter, chosen by a height
     threshold. Both are gone as a pair. The reason the split existed —
     "RemoteViews can't resize a fixed-dp row at runtime, setViewLayoutHeight is
     API 31+" — stops applying once no row has a fixed dp height: every row here
     is wrap_content, so row heights follow the text sizes the provider sets, on
     every API level, at any size the host grants. See WidgetMetrics' header for
     the size model and WidgetSize' header for the options-reading bug that made
     a 368x176dp widget render as if it were 96dp tall.

     ## Vertical slack

     widget_content is gravity="center_vertical" with wrap_content rows, so
     whatever the scale solver leaves over (it targets an exact fill, but clamps
     at both ends) splits evenly above and below the content instead of pooling
     as dead space under the footer — the "half the widget is empty" complaint
     that the old flexible-grid-row trick was meant to solve and didn't. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- ══ header: city · cursor · online dot · refresh ══════════════ -->
        <LinearLayout
            android:id="@+id/widget_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_city_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/widget_header_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="┌─ homebrew weather ─┐"
                    android:textColor="@color/widget_green_dim"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="_"
                android:textColor="@color/widget_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_online_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/widget_dot_online" />

            <FrameLayout
                android:id="@+id/widget_refresh_box"
                android:layout_width="13dp"
                android:layout_height="13dp">

                <ImageButton
                    android:id="@+id/widget_refresh_btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_refresh_hitbox"
                    android:padding="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_refresh" />

                <ProgressBar
                    android:id="@+id/widget_refresh_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/widget_cyan"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ══ hero: icon · big temp + condition · stat column ═══════════ -->
        <LinearLayout
            android:id="@+id/widget_hero_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_now_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" />

            <!-- Explicit 6:5 weights, not "whatever is left over": a previous
                 real-device bug had this cluster sharing a row with a
                 wrap_content stat column that ate enough width to render
                 widget_now_line completely blank. When widget_hero_stats is
                 GONE its weight drops out and this takes the full row. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_hero_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:shadowColor="@color/widget_hud_glow"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="7"
                        android:singleLine="true"
                        android:textColor="@color/widget_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Baseline-aligned by the parent's default
                         baselineAligned, so the unit sits on the temp's
                         baseline at any scale without a magic bottom margin. -->
                    <TextView
                        android:id="@+id/widget_hero_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="C"
                        android:textColor="@color/widget_cyan_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_now_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hero_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:gravity="end"
                android:orientation="vertical">

                <!-- Sparkline and its "max" figure share one row. They're one
                     reading (the 4-day rain trend and its peak), and stacking
                     them cost the hero row a whole line it didn't have: four
                     stacked stat lines measured taller than the temp +
                     condition stack beside them, so the hero row grew past its
                     budget and clipped the footer off the bottom of the widget.
                     See WidgetMetrics.REF_HERO — that budget assumes this
                     column is at most three lines. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_sparkline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:singleLine="true"
                        android:textColor="@color/widget_cyan"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/widget_pop_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/widget_cyan"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_aqi_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_sync_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ hairline rule ═════════════════════════════════════════════ -->
        <FrameLayout
            android:id="@+id/widget_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_hud_line" />

        <!-- ══ 4-day grid ════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/widget_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_col0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_today_col"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">

                <TextView
                    android:id="@+id/widget_day0_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_icon0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/widget_bar0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_pop0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:id="@+id/widget_col1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">

                <TextView
                    android:id="@+id/widget_day1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_icon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/widget_bar1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_pop1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:id="@+id/widget_col2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">

                <TextView
                    android:id="@+id/widget_day2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_icon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/widget_bar2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_pop2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_grid_divider" />

            <LinearLayout
                android:id="@+id/widget_col3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">

                <TextView
                    android:id="@+id/widget_day3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_green"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/widget_icon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp" />

                <TextView
                    android:id="@+id/widget_temp3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/widget_bar3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_pop3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/widget_cyan"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ meta + footer ═════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/widget_meta_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_green_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_footer_joke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/widget_amber"
            android:textSize="11sp" />

        <!-- Kept only so RemoteViews actions referencing it stay valid; the
             Terminal 2.0 mockup never had a separate comment line. -->
        <TextView
            android:id="@+id/widget_footer_comment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Status overlay (stale / offline / refreshing). Deliberately floats over
         the content rather than taking a row of its own — it is transient, and
         a row would change the layout budget every time connectivity blipped. -->
    <TextView
        android:id="@+id/widget_status_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_status_banner_bg"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/widget_amber"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
