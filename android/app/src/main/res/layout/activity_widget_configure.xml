<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="$ configure widget --city"
            android:textColor="#4a6a4a"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text="homebrew weather // widget setup"
            android:textColor="#33ff66"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/suggestion_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#0a0f0a"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#33ff66"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/city_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0a0f0a"
            android:fontFamily="monospace"
            android:hint="search city..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#33ff66"
            android:textColorHint="#4a6a4a"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/search_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#123312"
                android:fontFamily="monospace"
                android:text="[ search ]"
                android:textColor="#33ff66" />

            <Button
                android:id="@+id/locate_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#123312"
                android:fontFamily="monospace"
                android:text="[ use my location ]"
                android:textColor="#33ff66" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="#4a6a4a"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Personalization: per-widget-instance color theme + background
             transparency (see WidgetTheme.kt). Selections apply immediately,
             same as picking a city above — no separate "save" step. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="$ configure widget --theme"
            android:textColor="#4a6a4a"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/theme_phosphor_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="green"
                android:textColor="#33ff66"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/theme_amber_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="amber"
                android:textColor="#ffb000"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/theme_cyan_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="cyan"
                android:textColor="#55ffff"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/theme_crimson_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="crimson"
                android:textColor="#ff5555"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Auto (health): unlike the 4 fixed swatches above, this theme's color
             is computed live from current conditions (see WidgetTheme.AUTO_HEALTH
             + WeatherWidgetProvider.computeHealthTheme()) — full-width row of its
             own since it's conceptually a different kind of option, not a 5th hue. -->
        <TextView
            android:id="@+id/theme_auto_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0a0f0a"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="10dp"
            android:text="auto (health)"
            android:textColor="#33ff66"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="$ configure widget --opacity"
            android:textColor="#4a6a4a"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transparency_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#33ff66"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/transparency_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="3"
            android:progressTint="#33ff66"
            android:thumbTint="#33ff66" />

        <!-- Density: how much the widget shows (see WidgetDensity.kt). Standard
             is the default and shows only what's out of the ordinary today;
             full is every readout, always; minimal is temperature + 4 days. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="$ configure widget --density"
            android:textColor="#4a6a4a"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/density_minimal_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="minimal"
                android:textColor="#33ff66"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/density_standard_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="standard"
                android:textColor="#33ff66"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/density_full_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#0a0f0a"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="10dp"
                android:text="full"
                android:textColor="#33ff66"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/density_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="#4a6a4a"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
