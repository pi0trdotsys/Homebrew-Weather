# Release signing config for android/app/build.gradle.
#
# Copy to `keystore.properties` (same directory) and fill in. Both that file and
# the .jks it points at are gitignored — do not commit either, ever.
#
# Without this file the build still works; `assembleRelease` just produces an
# unsigned APK. Only the person cutting releases needs it.
#
# ---------------------------------------------------------------------------
# Generating a key (once, and then never again — see the warning below):
#
#   keytool -genkeypair \
#     -keystore android/homebrew-weather-release.jks \
#     -alias homebrew-weather \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000 \
#     -storetype PKCS12 \
#     -dname "CN=Homebrew Weather, O=pi0trdotsys, C=PL"
#
# WARNING: this key is the app's identity. Android will only accept an update
# to an installed app if the new APK is signed with the same key. Lose the
# keystore or its password and no existing install can ever be updated again —
# every user has to uninstall first, losing their widget configuration. Back it
# up somewhere that survives this machine dying.
# ---------------------------------------------------------------------------

# Path to the keystore, relative to the android/ directory.
storeFile=homebrew-weather-release.jks

storePassword=CHANGE_ME
keyAlias=homebrew-weather
keyPassword=CHANGE_ME
