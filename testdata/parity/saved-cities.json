    },
    {"name": "an oversized saved list is cut from the end to the cap, keeping a refreshed entry", "input": {"list": [{"name": "City 1", "lat": 41.0, "lon": 11.0}, {"name": "City 2", "lat": 42.0, "lon": 12.0}, {"name": "City 3", "lat": 43.0, "lon": 13.0}, {"name": "City 4", "lat": 44.0, "lon": 14.0}, {"name": "City 5", "lat": 45.0, "lon": 15.0}, {"name": "City 6", "lat": 46.0, "lon": 16.0}, {"name": "City 7", "lat": 47.0, "lon": 17.0}, {"name": "City 8", "lat": 48.0, "lon": 18.0}, {"name": "City 9", "lat": 49.0, "lon": 19.0}, {"name": "City 10", "lat": 50.0, "lon": 20.0}], "city": {"name": "Renamed", "lat": 45.0, "lon": 15.0}}, "expect": {"list": [{"name": "City 1", "lat": 41.0, "lon": 11.0}, {"name": "City 2", "lat": 42.0, "lon": 12.0}, {"name": "City 3", "lat": 43.0, "lon": 13.0}, {"name": "City 4", "lat": 44.0, "lon": 14.0}, {"name": "Renamed", "lat": 45.0, "lon": 15.0}, {"name": "City 6", "lat": 46.0, "lon": 16.0}, {"name": "City 7", "lat": 47.0, "lon": 17.0}, {"name": "City 8", "lat": 48.0, "lon": 18.0}]}}
