    {
      "name": "an hour east of UTC",
      "fn": "localMinute",
      "input": {"nowMs": 1794927930000, "offsetSeconds": 3600},
      "expect": {"iso": "2026-11-17T16:05"}
    },
    {
      "name": "seconds are cut, not rounded",
