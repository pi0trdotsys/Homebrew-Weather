    {
      "name": "dry forecast has no window",
      "fn": "today",
      "input": {
        "now": "2026-09-24T11:00",
        "currentCode": 0,
        "hourly": [
          ["2026-09-24T11:00", 0, 0, null],
          ["2026-09-24T12:00", 10, 0, null],
          ["2026-09-24T13:00", 20, 0, null],
          ["2026-09-24T14:00", 30, 0, null],
          ["2026-09-24T15:00", 40, 0, null],
          ["2026-09-24T16:00", 10, 0, null]
        ]
      },
      "expect": null
    },
