{
  "rule": "terrain",
  "note": "cellKey: the 0.1 degree cache cell, Java's %.1f (half-up on the shortest decimal). samplePoints: the 24 x 12 grid of [lat, lon] around a place, north to south and west to east; expect is a digest (count, a few points, sums). parseElevations: the elevation endpoint's body as metres, null when it isn't one. relief: highest minus lowest of a grid. Kotlin: Terrain.cellKey / samplePoints / parseElevations / Grid.relief; web: terrain.ts.",
  "cases": [
    {"name": "cellKey: a place and its neighbour share a cell (1)", "fn": "cellKey", "input": {"lat": 51.10286, "lon": 17.03006}, "expect": {"key": "51.1_17.0"}},
    {"name": "cellKey: a place and its neighbour share a cell (2)", "fn": "cellKey", "input": {"lat": 51.1049, "lon": 17.0301}, "expect": {"key": "51.1_17.0"}},
    {"name": "cellKey: Warsaw", "fn": "cellKey", "input": {"lat": 52.2297, "lon": 21.0122}, "expect": {"key": "52.2_21.0"}},
    {"name": "cellKey: Lima, both negative", "fn": "cellKey", "input": {"lat": -12.0464, "lon": -77.0428}, "expect": {"key": "-12.0_-77.0"}},
    {"name": "cellKey: Estepona, west longitude", "fn": "cellKey", "input": {"lat": 36.43, "lon": -5.15}, "expect": {"key": "36.4_-5.2"}},
    {"name": "cellKey: a tie in the latitude rounds half up", "fn": "cellKey", "input": {"lat": 50.05, "lon": 20}, "expect": {"key": "50.1_20.0"}},
    {"name": "cellKey: a tie in the longitude rounds half up", "fn": "cellKey", "input": {"lat": 51, "lon": 17.05}, "expect": {"key": "51.0_17.1"}},
    {"name": "cellKey: a tie that binary arithmetic would round down", "fn": "cellKey", "input": {"lat": 51.35, "lon": 17.45}, "expect": {"key": "51.4_17.5"}},
    {"name": "cellKey: a negative tie", "fn": "cellKey", "input": {"lat": -33.95, "lon": 18.45}, "expect": {"key": "-34.0_18.5"}},
    {"name": "cellKey: carry through nines", "fn": "cellKey", "input": {"lat": 9.95, "lon": 99.95}, "expect": {"key": "10.0_100.0"}},
    {"name": "cellKey: a tiny negative is minus zero", "fn": "cellKey", "input": {"lat": -0.04, "lon": 0.04}, "expect": {"key": "-0.0_0.0"}},
    {"name": "cellKey: the origin", "fn": "cellKey", "input": {"lat": 0, "lon": 0}, "expect": {"key": "0.0_0.0"}},
    {"name": "cellKey: near the pole and the date line", "fn": "cellKey", "input": {"lat": 89.99, "lon": -179.96}, "expect": {"key": "90.0_-180.0"}},
    {"name": "cellKey: whole degrees", "fn": "cellKey", "input": {"lat": 40, "lon": -74}, "expect": {"key": "40.0_-74.0"}},
    {"name": "samplePoints: Wrocław", "fn": "samplePoints", "input": {"lat": 51.1, "lon": 17.03}, "expect": {"count": 288, "first": [51.131532, 16.929575], "second": [51.131532, 16.938308], "endOfFirstRow": [51.131532, 17.130425], "startOfSecondRow": [51.125799, 16.929575], "middle": [51.097133, 16.981971], "last": [51.068468, 17.130425], "sumLat": 14716.8, "sumLon": 4904.64}},
    {"name": "samplePoints: the equator", "fn": "samplePoints", "input": {"lat": 0, "lon": 0}, "expect": {"count": 288, "first": [0.031532, -0.063063], "second": [0.031532, -0.057579], "endOfFirstRow": [0.031532, 0.063063], "startOfSecondRow": [0.025799, -0.063063], "middle": [-0.002867, -0.030161], "last": [-0.031532, 0.063063], "sumLat": 0, "sumLon": 0}},
    {"name": "samplePoints: Cape Town", "fn": "samplePoints", "input": {"lat": -33.92, "lon": 18.42}, "expect": {"count": 288, "first": [-33.888468, 18.344004], "second": [-33.888468, 18.350612], "endOfFirstRow": [-33.888468, 18.495996], "startOfSecondRow": [-33.894201, 18.344004], "middle": [-33.922867, 18.383654], "last": [-33.951532, 18.495996], "sumLat": -9768.96, "sumLon": 5304.96}},
    {"name": "samplePoints: Reykjavik", "fn": "samplePoints", "input": {"lat": 64.1466, "lon": -21.9426}, "expect": {"count": 288, "first": [64.178132, -22.087217], "second": [64.178132, -22.074641], "endOfFirstRow": [64.178132, -21.797983], "startOfSecondRow": [64.172399, -22.087217], "middle": [64.143733, -22.011765], "last": [64.115068, -21.797983], "sumLat": 18474.2208, "sumLon": -6319.4688}},
    {"name": "samplePoints: near the north pole", "fn": "samplePoints", "input": {"lat": 89.99, "lon": 10}, "expect": {"count": 288, "first": [90.021532, 8.738739], "second": [90.021532, 8.848414], "endOfFirstRow": [90.021532, 11.261261], "startOfSecondRow": [90.015799, 8.738739], "middle": [89.987133, 9.396788], "last": [89.958468, 11.261261], "sumLat": 25917.12, "sumLon": 2880}},
    {"name": "samplePoints: near the south pole", "fn": "samplePoints", "input": {"lat": -89.9, "lon": 0}, "expect": {"count": 288, "first": [-89.868468, -1.261261], "second": [-89.868468, -1.151586], "endOfFirstRow": [-89.868468, 1.261261], "startOfSecondRow": [-89.874201, -1.261261], "middle": [-89.902867, -0.603212], "last": [-89.931532, 1.261261], "sumLat": -25891.2, "sumLon": 0}},
    {"name": "samplePoints: the date line", "fn": "samplePoints", "input": {"lat": 0.5, "lon": 179.99}, "expect": {"count": 288, "first": [0.531532, 179.926935], "second": [0.531532, 179.932418], "endOfFirstRow": [0.531532, 180.053065], "startOfSecondRow": [0.525799, 179.926935], "middle": [0.497133, 179.959838], "last": [0.468468, 180.053065], "sumLat": 144, "sumLon": 51837.12}},
    {"name": "parseElevations: a plain list", "fn": "parseElevations", "input": {"json": "{\"elevation\":[290.0, 234.0, 302.0]}"}, "expect": {"elevations": [290, 234, 302]}},
    {"name": "parseElevations: whole numbers and negatives", "fn": "parseElevations", "input": {"json": "{\"elevation\":[1, -3, 0, 12.5]}"}, "expect": {"elevations": [1, -3, 0, 12.5]}},
    {"name": "parseElevations: an empty list", "fn": "parseElevations", "input": {"json": "{\"elevation\":[]}"}, "expect": {"elevations": []}},
    {"name": "parseElevations: other keys are ignored", "fn": "parseElevations", "input": {"json": "{\"latitude\":[51.1],\"elevation\":[120.0],\"generationtime_ms\":0.1}"}, "expect": {"elevations": [120]}},
    {"name": "parseElevations: a rate-limit answer", "fn": "parseElevations", "input": {"json": "{\"error\":true,\"reason\":\"Minutely API request limit exceeded.\"}"}, "expect": {"elevations": null}},
    {"name": "parseElevations: not json", "fn": "parseElevations", "input": {"json": "not json"}, "expect": {"elevations": null}},
    {"name": "parseElevations: an empty body", "fn": "parseElevations", "input": {"json": ""}, "expect": {"elevations": null}},
    {"name": "parseElevations: elevation is not a list", "fn": "parseElevations", "input": {"json": "{\"elevation\":\"high\"}"}, "expect": {"elevations": null}},
    {"name": "parseElevations: a list at the top", "fn": "parseElevations", "input": {"json": "[1,2,3]"}, "expect": {"elevations": null}},
    {"name": "parseElevations: a null among the numbers", "fn": "parseElevations", "input": {"json": "{\"elevation\":[1,null,3]}"}, "expect": {"elevations": null}},
    {"name": "parseElevations: a boolean among the numbers", "fn": "parseElevations", "input": {"json": "{\"elevation\":[1,true,3]}"}, "expect": {"elevations": null}},
    {"name": "parseElevations: a number written as a string", "fn": "parseElevations", "input": {"json": "{\"elevation\":[\"5\", 6]}"}, "expect": {"elevations": [5, 6]}},
    {"name": "parseElevations: a word among the numbers", "fn": "parseElevations", "input": {"json": "{\"elevation\":[\"abc\", 6]}"}, "expect": {"elevations": null}},
    {"name": "relief: a plain grid", "fn": "relief", "input": {"cols": 2, "rows": 2, "elevation": [10, 130, -5, 40]}, "expect": {"relief": 135}},
    {"name": "relief: a flat grid", "fn": "relief", "input": {"cols": 3, "rows": 2, "elevation": [16, 16, 16, 16, 16, 16]}, "expect": {"relief": 0}},
    {"name": "relief: one cell", "fn": "relief", "input": {"cols": 1, "rows": 1, "elevation": [220]}, "expect": {"relief": 0}},
    {"name": "relief: all below sea level", "fn": "relief", "input": {"cols": 2, "rows": 2, "elevation": [-10, -4, -30, -8]}, "expect": {"relief": 26}},
    {"name": "relief: Kielce-like hills", "fn": "relief", "input": {"cols": 4, "rows": 3, "elevation": [250, 310, 402, 380, 270, 300, 350, 330, 260, 255, 290, 288]}, "expect": {"relief": 152}}
  ]
}
