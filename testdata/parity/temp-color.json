{
  "rule": "temp-color",
  "note": "The temperature colour scale: stops -15 #7a9bff, 0 #55ffff, 22 #ffb000, 35 #ff5555, clamped outside, linear per channel between neighbours with floor(a + (b - a) * f + 0.5); an unknown (null) temperature reads as the 0 degree cyan. input.celsius is C or null; expect.hex is lowercase #rrggbb. Kotlin: TempColor.hex; web: tempColor.",
  "cases": [
    {"name": "the cold stop", "input": {"celsius": -15}, "expect": {"hex": "#7a9bff"}},
    {"name": "the freezing stop", "input": {"celsius": 0}, "expect": {"hex": "#55ffff"}},
    {"name": "the warm stop", "input": {"celsius": 22}, "expect": {"hex": "#ffb000"}},
    {"name": "the hot stop", "input": {"celsius": 35}, "expect": {"hex": "#ff5555"}},
    {"name": "far below the cold stop", "input": {"celsius": -40}, "expect": {"hex": "#7a9bff"}},
    {"name": "just below the cold stop", "input": {"celsius": -15.5}, "expect": {"hex": "#7a9bff"}},
    {"name": "far above the hot stop", "input": {"celsius": 48}, "expect": {"hex": "#ff5555"}},
    {"name": "just above the hot stop", "input": {"celsius": 35.2}, "expect": {"hex": "#ff5555"}},
    {"name": "midpoint of cold and freezing", "input": {"celsius": -7.5}, "expect": {"hex": "#68cdff"}},
    {"name": "midpoint of freezing and warm", "input": {"celsius": 11}, "expect": {"hex": "#aad880"}},
    {"name": "midpoint of warm and hot", "input": {"celsius": 28.5}, "expect": {"hex": "#ff832b"}},
    {"name": "a quarter of the way up", "input": {"celsius": -11.25}, "expect": {"hex": "#71b4ff"}},
    {"name": "-10", "input": {"celsius": -10}, "expect": {"hex": "#6ebcff"}},
    {"name": "-5", "input": {"celsius": -5}, "expect": {"hex": "#61deff"}},
    {"name": "-1", "input": {"celsius": -1}, "expect": {"hex": "#57f8ff"}},
    {"name": "a tenth below freezing", "input": {"celsius": -0.1}, "expect": {"hex": "#55feff"}},
    {"name": "a tenth above freezing", "input": {"celsius": 0.1}, "expect": {"hex": "#56fffe"}},
    {"name": "1", "input": {"celsius": 1}, "expect": {"hex": "#5dfbf3"}},
    {"name": "5", "input": {"celsius": 5}, "expect": {"hex": "#7cedc5"}},
    {"name": "10", "input": {"celsius": 10}, "expect": {"hex": "#a2db8b"}},
    {"name": "15", "input": {"celsius": 15}, "expect": {"hex": "#c9c951"}},
    {"name": "20", "input": {"celsius": 20}, "expect": {"hex": "#f0b717"}},
    {"name": "21.9", "input": {"celsius": 21.9}, "expect": {"hex": "#feb001"}},
    {"name": "22.1", "input": {"celsius": 22.1}, "expect": {"hex": "#ffaf01"}},
    {"name": "25", "input": {"celsius": 25}, "expect": {"hex": "#ff9b14"}},
    {"name": "30", "input": {"celsius": 30}, "expect": {"hex": "#ff7834"}},
    {"name": "34.9", "input": {"celsius": 34.9}, "expect": {"hex": "#ff5654"}},
    {"name": "fractions that round up", "input": {"celsius": 3.7}, "expect": {"hex": "#72f2d4"}},
    {"name": "fractions that round down", "input": {"celsius": 3.2}, "expect": {"hex": "#6ef4da"}},
    {"name": "a long fraction", "input": {"celsius": 17.123456}, "expect": {"hex": "#d9c239"}},
    {"name": "unknown is the freezing cyan", "input": {"celsius": null}, "expect": {"hex": "#55ffff"}}
  ]
}
