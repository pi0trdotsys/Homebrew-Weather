{
  "rule": "wellbeing-situation",
  "note": "hour is the local hour of the current time (null: no hourly data, Kotlin only). isDay is the sun being up now. uvMax is today's UV maximum. aqi (US AQI, -1 unknown) and pollen (grains/m3 per kind) exist only on the Kotlin side, so cases that set them are marked only: kotlin; the web never returns air or pollen.",
  "cases": [
    {
      "name": "an ordinary day is calm",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "30 degrees is hot",
      "input": {"hour": 12, "isDay": true, "temp": 30.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "hot"}
    },
    {
      "name": "29.9 degrees is not",
      "input": {"hour": 12, "isDay": true, "temp": 29.9, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "0 degrees is cold",
      "input": {"hour": 12, "isDay": true, "temp": 0.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "cold"}
    },
    {
      "name": "0.1 degrees is not cold",
      "input": {"hour": 12, "isDay": true, "temp": 0.1, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "below freezing is cold",
      "input": {"hour": 12, "isDay": true, "temp": -2.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "cold"}
    },
    {
      "name": "rain falling now",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 61, "gust": null, "uvMax": null},
      "expect": {"situation": "rain"}
    },
    {
      "name": "showers falling now",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 80, "gust": null, "uvMax": null},
      "expect": {"situation": "rain"}
    },
    {
      "name": "a storm falling now is rain",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 95, "gust": null, "uvMax": null},
      "expect": {"situation": "rain"}
    },
    {
      "name": "snow is not a rain tip",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 71, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "fog is calm",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 45, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "a gust of 60 is wind",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": 60.0, "uvMax": null},
      "expect": {"situation": "wind"}
    },
    {
      "name": "a gust of 59.9 is not",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": 59.9, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "night after dark",
      "input": {"hour": 23, "isDay": false, "temp": 18.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "night"}
    },
    {
      "name": "after dark in the small hours",
      "input": {"hour": 2, "isDay": false, "temp": 18.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "night"}
    },
    {
      "name": "UV 8 in the daytime is strong sun",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": 8.0},
      "expect": {"situation": "sun"}
    },
    {
      "name": "UV 7.9 is not",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": 7.9},
      "expect": {"situation": "calm"}
    },
    {
      "name": "UV 8 at 17:xx is still daytime",
      "input": {"hour": 17, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": 8.0},
      "expect": {"situation": "sun"}
    },
    {
      "name": "UV 8 from 18 on is evening, not sun",
      "input": {"hour": 18, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": 8.0},
      "expect": {"situation": "calm"}
    },
    {
