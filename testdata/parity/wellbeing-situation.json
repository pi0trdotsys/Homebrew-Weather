    {
      "name": "an unknown temperature never triggers hot or cold",
      "input": {"hour": 12, "isDay": true, "temp": null, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "an unknown gust never triggers wind",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "calm"}
    },
    {
      "name": "everything unknown at night is night",
      "input": {"hour": 12, "isDay": false, "temp": null, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "night"}
    },
    {
      "name": "sun wins over heat",
      "input": {"hour": 12, "isDay": true, "temp": 33.0, "code": 1, "gust": null, "uvMax": 10.0},
      "expect": {"situation": "sun"}
    },
    {
      "name": "heat wins over rain",
      "input": {"hour": 12, "isDay": true, "temp": 33.0, "code": 61, "gust": null, "uvMax": null},
