    },
    {
      "name": "rain wins over wind",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 61, "gust": 80.0, "uvMax": null},
      "expect": {"situation": "rain"}
    },
    {
      "name": "wind wins over night",
      "input": {"hour": 23, "isDay": false, "temp": 18.0, "code": 1, "gust": 70.0, "uvMax": null},
      "expect": {"situation": "wind"}
    },
    {
      "name": "hot wins over night",
      "input": {"hour": 23, "isDay": false, "temp": 31.0, "code": 1, "gust": null, "uvMax": null},
      "expect": {"situation": "hot"}
    },
    {
      "name": "rain wins over night",
      "input": {"hour": 23, "isDay": false, "temp": 18.0, "code": 61, "gust": null, "uvMax": null},
      "expect": {"situation": "rain"}
    },
    {
      "name": "sun beats heat and rain together",
      "input": {"hour": 12, "isDay": true, "temp": 32.0, "code": 61, "gust": null, "uvMax": 9.0},
      "expect": {"situation": "sun"}
    },
    {
      "name": "US AQI 101 is bad air",
      "only": "kotlin",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": null, "aqi": 101},
      "expect": {"situation": "air"}
    },
    {
      "name": "US AQI 100 is not",
      "only": "kotlin",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": null, "aqi": 100},
      "expect": {"situation": "calm"}
    },
    {
      "name": "an unknown AQI (-1) never triggers air",
      "only": "kotlin",
      "input": {"hour": 12, "isDay": true, "temp": 18.0, "code": 1, "gust": null, "uvMax": null, "aqi": -1},
      "expect": {"situation": "calm"}
    },
    {
